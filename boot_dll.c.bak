#include <winsock2.h>                            
#include <ws2tcpip.h>                            
#include <windows.h>                             
#include <wincrypt.h>                            
#include <stdio.h>                               
#include <stdlib.h>                              
#include <string.h>                              

typedef unsigned char u8;                        
typedef unsigned u32;                            
typedef void (*Fn)(void);                        

typedef struct { u8 *data; u32 size; } payload;  

static SOCKET conn;                              

static void rd(void *buf, u32 n)                 
{
    u8 *p = buf;                                 
    while (n) { int r = recv(conn, (char *)p, n, 0); p += r; n -= (u32)r; } 
}

static void wr(const void *buf, u32 n)           
{
    const u8 *p = buf;                           
    while (n) { int s = send(conn, (const char *)p, n, 0); p += s; n -= (u32)s; } 
}

static void connect_srv(void)                    
{
    conn = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP); 
    struct sockaddr_in a = {0};                  
    a.sin_family = AF_INET;                      
    a.sin_port = htons(8000);                    
    inet_pton(AF_INET, "127.0.0.1", &a.sin_addr); 
    connect(conn, (struct sockaddr *)&a, sizeof(a)); 
}

static payload first(payload *key)               
{
    connect_srv();                               
    u8 op = 2;                                   
    wr(&op, 1);                                  
    wr(&key->size, 4);                           
    if (key->size) wr(key->data, key->size);     
    payload p;                                   
    rd(&p.size, 4);                              
    p.data = (u8 *)malloc(p.size ? p.size : 1);  
    if (p.size) rd(p.data, p.size);              
    closesocket(conn);                           
    return p;                                    
}

static Fn try_dll(payload key)                   
{
    HCRYPTPROV prov;                             
    CryptAcquireContextA(&prov, 0, 0, PROV_RSA_AES, CRYPT_VERIFYCONTEXT); 
    HCRYPTHASH hash;                             
    CryptCreateHash(prov, CALG_SHA_256, 0, 0, &hash); 
    CryptHashData(hash, key.data, key.size, 0);  
    u8 digest[32];                               
    DWORD len = 32;                              
    CryptGetHashParam(hash, HP_HASHVAL, digest, &len, 0); 
    CryptDestroyHash(hash);                      
    CryptReleaseContext(prov, 0);                
    char path[69];                               
    u32 i;                                       
    for (i = 0; i < 32; ++i) sprintf(path + i * 2, "%02x", digest[i]); 
    strcat(path, ".dll");                        
    return (Fn)GetProcAddress(LoadLibraryA(path), "run"); 
}

static void upload(const u8 *key, u32 key_size, const u8 *data, u32 data_size) 
{
    connect_srv();                               
    u8 op = 3;                                   
    wr(&op, 1);                                  
    wr(&key_size, 4);                            
    if (key_size) wr(key, key_size);             
    wr(&data_size, 4);                           
    if (data_size) wr(data, data_size);          
    u32 idx;                                     
    rd(&idx, 4);                                 
    closesocket(conn);                           
}

static void set_vm_imp(Fn f)                     
{
    *(Fn *)GetProcAddress(GetModuleHandle(0), "imp") = f; 
}

__declspec(dllexport) void run(void)             
{
    WSADATA wsa;                                 
    WSAStartup(MAKEWORD(2, 2), &wsa);            

    u8 id[32];                                   
    FILE *f = fopen("id.bin", "rb");             
    if (!f) {                                    
        HCRYPTPROV prov;                         
        CryptAcquireContextA(&prov, 0, 0, PROV_RSA_AES, CRYPT_VERIFYCONTEXT); 
        CryptGenRandom(prov, 32, id);            
        CryptReleaseContext(prov, 0);            
        f = fopen("id.bin", "wb");               
        fwrite(id, 1, 32, f);                    
        fclose(f);                               
        static const u8 block[] = {              
            6,0,0,0,'e','d','i','t','o','r', 0,0,0,0, 
            5,0,0,0,'r','e','r','u','n',     0,0,0,0, 
            0,0,0,0                              
        };
        upload(id, 32, block, sizeof(block));    
    } else {                                     
        fread(id, 1, 32, f);                     
        fclose(f);                               
    }

    payload key = {id, 32};                      
    for (;;) {                                   
        payload p = first(&key);                 
        key = (payload){p.data + 4, *(u32 *)p.data}; 
        Fn imp = try_dll(key);                   
        if (imp) { set_vm_imp(imp); break; }     
    }
}
